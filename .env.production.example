# ============================================================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# ============================================================================
# ⚠️  DO NOT commit this file to git after adding real values!
# ⚠️  Copy to .env.production and update with your actual production values
#
# Usage:
#   docker compose --env-file .env.production up -d

# ============================================================================
# DATABASE - Choose ONE option
# ============================================================================

# Option 1: External PostgreSQL (Recommended)
DATABASE_URL="postgresql://ocruser:YOUR_SECURE_PASSWORD@db.example.com:5432/ocrdb?sslmode=require&connection_limit=20"
# DB_PROFILE=none  # Don't start postgres (external DB)

# Option 2: Turso (Edge SQLite - Great for global apps)
# DATABASE_URL="libsql://your-db-name.turso.io"
# TURSO_AUTH_TOKEN="your_auth_token_here"
# DB_PROFILE=none  # Don't start postgres

# Option 3: Local PostgreSQL (if using local DB in production - not recommended)
# DATABASE_URL="postgresql://ocruser:YOUR_SECURE_PASSWORD@postgres:5432/ocrdb"
# DB_PROFILE=default  # Start postgres

# ============================================================================
# APPLICATION URLS (⚠️ CRITICAL - Must set for production!)
# ============================================================================

# Main application domain
APP_DOMAIN="https://ocrtools.com"

# API base URL (leave empty if API on same domain as frontend)
NEXT_PUBLIC_API_BASE_URL=""

# Or if API on different domain:
# NEXT_PUBLIC_API_BASE_URL="https://api.ocrtools.com"

# ============================================================================
# ENVIRONMENT
# ============================================================================

NODE_ENV="production"

# ============================================================================
# ADMIN PANEL AUTHENTICATION (OIDC) — ⚠️ REQUIRED in production
# ============================================================================
# The /admin dashboard and /api/admin/* routes are protected by OpenID
# Connect. Leave ADMIN_AUTH_DISABLED unset/false in production — setting it to
# true makes the admin panel (job data, delete/reset) publicly accessible.
ADMIN_AUTH_DISABLED=false

# Canonical app URL and a strong random secret for signing the session JWT.
NEXTAUTH_URL="https://ocrtools.com"
NEXTAUTH_SECRET="CHANGE_ME"   # ⚠️ generate with: openssl rand -base64 32

# OIDC provider (Authentik, Keycloak, Auth0, Azure AD, Google, ...).
OIDC_ISSUER="https://auth.example.com/application/o/ocr"
OIDC_CLIENT_ID="your-client-id"
OIDC_CLIENT_SECRET="your-client-secret"
# OIDC_SCOPES="openid email profile"     # optional
# OIDC_PROVIDER_NAME="Company SSO"        # optional, shown on sign-in button

# Authorization: ANY user the IdP authenticates becomes an admin. Lock down
# access at the IdP (scope the OIDC application to your admins) instead.

# Register this redirect/callback URL in the IdP:
#   https://ocrtools.com/api/auth/callback/oidc

# ============================================================================
# PERFORMANCE TUNING
# ============================================================================

# Number of worker instances (for horizontal scaling)
WORKER_REPLICAS=1

# ============================================================================
# POSTGRESQL CONFIGURATION (if using local postgres)
# ============================================================================

POSTGRES_USER="ocruser"
POSTGRES_PASSWORD="YOUR_VERY_SECURE_PASSWORD_HERE"  # ⚠️ Change this!
POSTGRES_DB="ocrdb"
POSTGRES_PORT=15433

# Performance settings
POSTGRES_SHARED_BUFFERS=256MB
POSTGRES_WORK_MEM=16MB
POSTGRES_MAX_CONNECTIONS=100

# ============================================================================
# PORTS
# ============================================================================

API_PORT=14580

# ============================================================================
# RESOURCE LIMITS (Production)
# ============================================================================

# PostgreSQL
POSTGRES_CPU_LIMIT=2.0
POSTGRES_MEMORY_LIMIT=2G
POSTGRES_CPU_RESERVE=0.5
POSTGRES_MEMORY_RESERVE=512M

# API Server
API_CPU_LIMIT=2.0
API_MEMORY_LIMIT=2G
API_CPU_RESERVE=0.5
API_MEMORY_RESERVE=512M

# Worker (OCR is CPU intensive)
WORKER_CPU_LIMIT=4.0
WORKER_MEMORY_LIMIT=4G
WORKER_CPU_RESERVE=1.0
WORKER_MEMORY_RESERVE=1G

# ============================================================================
# RESTART POLICIES (Production)
# ============================================================================

RESTART_POLICY=unless-stopped
RESTART_CONDITION=on-failure
RESTART_DELAY=5s
RESTART_MAX_ATTEMPTS=3
RESTART_WINDOW=120s

# ============================================================================
# HEALTH CHECKS (Production)
# ============================================================================

DISABLE_HEALTHCHECK=false
HEALTHCHECK_INTERVAL=30s
HEALTHCHECK_TIMEOUT=10s
HEALTHCHECK_RETRIES=3
API_START_PERIOD=40s
WORKER_START_PERIOD=30s
POSTGRES_START_PERIOD=10s

# ============================================================================
# LOGGING (Production)
# ============================================================================

LOG_DRIVER=json-file
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3

# ============================================================================
# SECURITY CHECKLIST
# ============================================================================
# Before deploying to production:
# [ ] Changed all default passwords
# [ ] Set APP_DOMAIN to your actual domain
# [ ] Configured SSL/HTTPS
# [ ] Set up firewall rules
# [ ] Configured backups
# [ ] Set up monitoring
# [ ] Reviewed DEPLOYMENT.md security checklist
# [ ] DO NOT commit this file with real values!
