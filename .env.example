# ============================================================================
# DEVELOPMENT ENVIRONMENT CONFIGURATION
# ============================================================================
# Copy to .env and customize for your local development setup
#
# Usage:
#   docker compose up -d

# ============================================================================
# DATABASE - Choose ONE option
# ============================================================================

# OPTION 1: Local PostgreSQL (Docker Compose - Default)
DATABASE_URL="postgresql://ocruser:ocrpassword@localhost:5433/ocrdb"
DB_PROFILE=default  # Start postgres

# OPTION 2: External PostgreSQL (AWS RDS, DigitalOcean, etc.)
# DATABASE_URL="postgresql://username:password@db.example.com:5432/ocrdb?sslmode=require"
# DB_PROFILE=none  # Don't start postgres

# OPTION 3: Turso / LibSQL (Edge-hosted SQLite)
# DATABASE_URL="libsql://your-db-name.turso.io"
# TURSO_AUTH_TOKEN="your_auth_token_here"
# DB_PROFILE=none  # Don't start postgres

# Or local SQLite file for development:
# DATABASE_URL="file:./dev.db"
# DB_PROFILE=none  # Don't start postgres

# ============================================================================
# APPLICATION URLS
# ============================================================================

APP_DOMAIN="http://localhost:3040"
NEXT_PUBLIC_API_BASE_URL=""

# ============================================================================
# ENVIRONMENT
# ============================================================================

NODE_ENV="development"

# ============================================================================
# PERFORMANCE TUNING
# ============================================================================

PDF_PAGE_CONCURRENCY=4
WORKER_REPLICAS=1

# ============================================================================
# POSTGRESQL CONFIGURATION (if using local postgres)
# ============================================================================

POSTGRES_USER="ocruser"
POSTGRES_PASSWORD="ocrpassword"
POSTGRES_DB="ocrdb"
POSTGRES_PORT=5433

# ============================================================================
# PORTS
# ============================================================================

API_PORT=3040

# ============================================================================
# DEVELOPMENT DEFAULTS (no resource limits, no restarts)
# ============================================================================

# No resource limits in development
POSTGRES_CPU_LIMIT=8.0
POSTGRES_MEMORY_LIMIT=8G
API_CPU_LIMIT=8.0
API_MEMORY_LIMIT=8G
WORKER_CPU_LIMIT=8.0
WORKER_MEMORY_LIMIT=8G

# No automatic restarts in development
RESTART_POLICY=no

# Disable health checks in development (optional, faster startup)
# DISABLE_HEALTHCHECK=true

# Less strict logging in development
LOG_MAX_SIZE=100m
LOG_MAX_FILE=1
