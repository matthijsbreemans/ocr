# ============================================================================
# DEVELOPMENT ENVIRONMENT CONFIGURATION
# ============================================================================
# Copy to .env and customize for your local development setup
#
# Usage:
#   docker compose up -d

# ============================================================================
# DATABASE - Choose ONE option
# ============================================================================

# OPTION 1: SQLite (Default for local development - no Docker needed)
# NOTE: SQLite only works for host-based dev (npm run dev + npm run worker).
# Do NOT use it with docker compose: the api and worker containers would each
# get their own private copy of the database file, and uploaded jobs would
# stay PENDING forever because the worker never sees them.
DATABASE_URL="file:./dev.db"
DB_PROFILE=none

# OPTION 2: Local PostgreSQL (Docker Compose)
# DOCKER_DATABASE_URL is what the api/worker containers use; it overrides
# DATABASE_URL inside docker so the host can keep using SQLite (Option 1).
# COMPOSE_PROFILES=default is what actually starts the postgres container
# (DB_PROFILE only names the profile, it does not activate it).
# DOCKER_DATABASE_URL="postgresql://ocruser:ocrpassword@postgres:5432/ocrdb"
# COMPOSE_PROFILES=default
# For host tooling against the docker postgres (prisma studio etc.):
# DATABASE_URL="postgresql://ocruser:ocrpassword@localhost:15433/ocrdb"

# OPTION 3: External PostgreSQL (AWS RDS, DigitalOcean, etc.)
# DATABASE_URL="postgresql://username:password@db.example.com:5432/ocrdb?sslmode=require"
# DB_PROFILE=none

# ============================================================================
# APPLICATION URLS
# ============================================================================

APP_DOMAIN="http://localhost:14580"
NEXT_PUBLIC_API_BASE_URL=""

# ============================================================================
# ENVIRONMENT
# ============================================================================

NODE_ENV="development"

# ============================================================================
# ADMIN PANEL AUTHENTICATION (OIDC)
# ============================================================================
# The /admin dashboard and /api/admin/* routes are protected by OpenID
# Connect. For local development the simplest option is to disable auth:
ADMIN_AUTH_DISABLED=true

# To test the real OIDC flow locally, set ADMIN_AUTH_DISABLED=false and fill
# in a provider (Authentik, Keycloak, Auth0, Azure AD, Google, ...):
# NEXTAUTH_URL="http://localhost:14580"
# NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"
# OIDC_ISSUER="https://auth.example.com/application/o/ocr"
# OIDC_CLIENT_ID="your-client-id"
# OIDC_CLIENT_SECRET="your-client-secret"
# OIDC_SCOPES="openid email profile"          # optional
# OIDC_PROVIDER_NAME="Company SSO"            # optional, shown on sign-in button
#
# Authorization: ANY user the IdP authenticates becomes an admin. Restrict
# access at the IdP (scope the OIDC application to your admins) instead.
#
# Redirect/callback URL to register in the IdP:
#   <NEXTAUTH_URL>/api/auth/callback/oidc

# ============================================================================
# EMAIL NOTIFICATIONS (SMTP) - optional
# ============================================================================
# Used to notify the uploader when a webhook delivery fails. This matters most
# for "Don't store the OCR result" uploads, where the webhook is the only copy
# of the result: if it can't be delivered the job is failed and the data is
# discarded, so the email is the user's only signal. Email is skipped entirely
# when SMTP_HOST is unset.
# SMTP_HOST="smtp.example.com"
# SMTP_PORT=587                                # 465 implies implicit TLS
# SMTP_SECURE=false                            # true for implicit TLS (port 465)
# SMTP_USER="apikey-or-username"               # omit for unauthenticated relay
# SMTP_PASS="your-smtp-password"
# SMTP_FROM="OCR API <no-reply@example.com>"

# ============================================================================
# OCR ENGINE
# ============================================================================

# Python interpreter used to run paddle_ocr.py
# Defaults: "python" on Windows, "python3" elsewhere
# PYTHON_BIN=python

# Path to the PaddleOCR wrapper script (defaults to ./paddle_ocr.py)
# PADDLE_OCR_SCRIPT=/app/paddle_ocr.py

# Hard timeouts (ms) for the OCR/render child processes. The child is SIGKILLed
# when exceeded so a wedged process can't outlive the job and pile up.
# OCR_TIMEOUT_MS=240000          # PaddleOCR, default 4 min
# GHOSTSCRIPT_TIMEOUT_MS=120000  # PDF->image render, default 2 min

# Max PDF pages rendered/OCR'd per job (bounds memory). Default 100.
# MAX_OCR_PAGES=100

# ============================================================================
# PERFORMANCE TUNING
# ============================================================================

WORKER_REPLICAS=1

# ============================================================================
# POSTGRESQL CONFIGURATION (if using local postgres)
# ============================================================================

POSTGRES_USER="ocruser"
POSTGRES_PASSWORD="ocrpassword"
POSTGRES_DB="ocrdb"
POSTGRES_PORT=15433

# ============================================================================
# PORTS
# ============================================================================

API_PORT=14580

# ============================================================================
# DEVELOPMENT DEFAULTS (no resource limits, no restarts)
# ============================================================================

# No resource limits in development
POSTGRES_CPU_LIMIT=8.0
POSTGRES_MEMORY_LIMIT=8G
API_CPU_LIMIT=8.0
API_MEMORY_LIMIT=8G
WORKER_CPU_LIMIT=8.0
WORKER_MEMORY_LIMIT=8G

# No automatic restarts in development
RESTART_POLICY=no

# Disable health checks in development (optional, faster startup)
# DISABLE_HEALTHCHECK=true

# Less strict logging in development
LOG_MAX_SIZE=100m
LOG_MAX_FILE=1
