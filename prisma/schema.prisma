// Prisma schema template - source of truth for the database schema.
// DO NOT edit prisma/schema.prisma directly - it is auto-generated from this file.
// After editing, run: npm run db:setup

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Job {
  id              String    @id @default(uuid())
  status    String    @default("PENDING")
  documentType    String    @map("document_type")
  email           String
  callbackWebhook String?   @map("callback_webhook")
  storeResult     Boolean   @default(true) @map("store_result")
  language        String    @default("eng")
  ocrMode         String    @default("auto") @map("ocr_mode")
  // Nullable: the source file is always wiped once the job reaches a terminal
  // state, and stays null afterwards. Only populated while PENDING/PROCESSING.
  fileData        Bytes?    @map("file_data")
  fileName        String    @map("file_name")
  mimeType        String    @map("mime_type")
  ocrResult       String?   @map("ocr_result")
  errorMessage    String?   @map("error_message")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  processedAt     DateTime? @map("processed_at")

  @@index([status, createdAt])
  @@map("jobs")
}


